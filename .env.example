APP_NAME="Casa Vergara"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=casa_vergara
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Set to true when the site is served over HTTPS
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ---- Outgoing email through Gmail SMTP ----
# MAIL_PASSWORD is a Google App Password (16 letters, NO spaces):
# Google Account > Security > 2-Step Verification > App passwords
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=youraddress@gmail.com
MAIL_FROM_NAME="Casa Vergara"
# Set to false only if you get a certificate error on XAMPP/Windows.
MAIL_VERIFY_PEER=true

# ---- Casa Vergara (was config/secrets.php) ----
# Public address of the site, no trailing slash (defaults to APP_URL).
# On the live site set this to your https domain, e.g. https://casavergararesort.online
# so the email logo loads (the logo is taken from <this url>/images/logo-email.png)
CVR_SITE_URL=
CVR_MAIL_FROM_EMAIL=youraddress@gmail.com
CVR_MAIL_FROM_NAME="Casa Vergara"
CVR_ADMIN_NOTIFY_EMAIL=youraddress@gmail.com
CVR_ACTIVITY_EMAILS=true
# Optional: full public https link to the email logo. Leave empty to use CVR_SITE_URL/images/logo-email.png
CVR_MAIL_LOGO_URL=
CVR_ADMIN_NOTIFY_NAME="Casa Vergara Admin"
# AI assistant (Google AI Studio key: https://aistudio.google.com/apikey)
CVR_AI_API_KEY=
CVR_AI_MODEL=gemini-3.8-flash
# Optional GIF search in live chat (free key at developers.giphy.com)
CVR_GIPHY_API_KEY=
# Secrets for the cron-by-URL reminder jobs (/scripts/send-checkin-reminders?key=...)
CVR_CHECKIN_REMINDER_SECRET=change-me-checkin
CVR_CHECKOUT_REMINDER_SECRET=change-me-checkout
# Mailbox probe on registration: asks Google/the mail server whether the address exists.
# Needs outbound port 25; if your network blocks it the check is skipped and the emailed code confirms the address.
CVR_EMAIL_SMTP_PROBE_ENABLED=true
